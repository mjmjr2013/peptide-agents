# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Airtable
AIRTABLE_API_KEY=pat...
AIRTABLE_BASE_ID=app...

# Meta Ads
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_BUSINESS_MANAGER_ID=

# Twilio
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1...

# SendGrid
SENDGRID_API_KEY=SG....
SENDGRID_FROM_EMAIL=orders@yourcompany.com

# Business config
COMPANY_NAME=PeptideCo
FROM_PHONE=+1...

# ── Warehouse payouts (HANDOFF §32) ──────────────────────────────────────────
# Jason is paid $12 per shipped box PLUS $15.90 per kg of gross weight (product
# plus the 350 g empty box, one per package), nightly, in USDT on Tron, right
# after the daily manifest email. PAYOUT_TRON_PRIVATE_KEY is the only secret in this repo
# that can SPEND — use a DEDICATED wallet holding a small float, never the
# customer receiving address and never a personal wallet.
WAREHOUSE_FEE_PER_BOX_USD=12
WAREHOUSE_FEE_PER_KG_USD=15.90
WAREHOUSE_FEE_START_DATE=            # YYYY-MM-DD, zero padded. REQUIRED.
JASON_TRON_ADDRESS=                  # T...
PAYOUT_TRON_PRIVATE_KEY=             # 64 hex chars, dedicated wallet
PAYOUT_DRY_RUN=1                     # 1 = calculate and email, send nothing
PAYOUT_MAX_USD=3000                  # refuse an absurd night; 0 disables
PAYOUT_ASSET=USDT                    # USDT only; TRX is refused
TRONGRID_API_KEY=                    # optional, avoids anonymous rate limits
PAYOUT_STATEMENT_EMAIL=              # defaults to WAREHOUSE_EMAIL
